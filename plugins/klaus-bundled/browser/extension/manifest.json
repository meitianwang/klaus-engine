{
  "manifest_version": 3,
  "name": "Klaus Browser Connector",
  "version": "0.1.0",
  "description": "Connects Klaus Agent to the user's Chrome tabs through a local browser bridge.",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Klaus Browser Connector"
  }
}
