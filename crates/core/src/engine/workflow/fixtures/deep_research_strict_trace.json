        {
          "idx": 0,
          "kind": "decompose",
          "prompt": "Break this research question into 2-6 INDEPENDENT sub-questions that can be researched separately. Independent = answering one does not depend on another. If the question is already simple, return a single-element array. Return ONLY JSON matching the schema.\n\nQuestion: the question",
          "options": {
            "agentType": null,
            "model": null,
            "isolation": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "subquestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "subquestions"
              ]
            }
          }
        },
        {
          "idx": 1,
          "kind": "research",
          "prompt": "Research this question with web_search and web_fetch. Extract every load-bearing fact as a separate CLAIM. For each claim provide: text (the claim), sourceUrl (the exact page URL it came from), sourceTitle, and quote (a short verbatim excerpt from that page that supports it). NEVER include a claim you cannot tie to a specific page you actually opened. Return ONLY JSON matching the schema.\n\nQuestion: only sub-question",
          "options": {
            "agentType": "researcher",
            "model": null,
            "isolation": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "sourceUrl": {
                        "type": "string"
                      },
                      "sourceTitle": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text",
                      "sourceUrl"
                    ]
                  }
                }
              },
              "required": [
                "claims"
              ]
            }
          }
        },
        {
          "idx": 2,
          "kind": "verify:Fact A",
          "prompt": "Decide whether the SOURCE actually supports the CLAIM. Re-read the source with web_fetch if needed. Answer supported=true ONLY if the source clearly states or directly entails the claim. If you are unsure, the page does not actually say it, or you cannot access the source, answer supported=false. Return ONLY JSON {\"supported\": boolean, \"reason\": \"...\"}.\n\nCLAIM: Fact A\nSOURCE URL: https://a.example/x\nRESEARCHER QUOTE: qa",
          "options": {
            "agentType": "researcher",
            "model": null,
            "isolation": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "supported": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "supported"
              ]
            }
          }
        },
        {
          "idx": 3,
          "kind": "verify:Fact B",
          "prompt": "Decide whether the SOURCE actually supports the CLAIM. Re-read the source with web_fetch if needed. Answer supported=true ONLY if the source clearly states or directly entails the claim. If you are unsure, the page does not actually say it, or you cannot access the source, answer supported=false. Return ONLY JSON {\"supported\": boolean, \"reason\": \"...\"}.\n\nCLAIM: Fact B\nSOURCE URL: https://b.example/y\nRESEARCHER QUOTE: qb",
          "options": {
            "agentType": "researcher",
            "model": null,
            "isolation": null,
            "outputSchema": {
              "type": "object",
              "properties": {
                "supported": {
