        },
        {
          "idx": 4,
          "kind": "synthesize",
          "prompt": "Write a clear, conclusion-first report answering the QUESTION using ONLY the VERIFIED CLAIMS below. Lead with the direct answer in the first 1-3 sentences, then supporting detail organized by theme. Each claim is tagged with a source id in parentheses; when you state that claim, cite it inline as [id] using that SAME id. Do NOT introduce any fact that is not in the verified claims, and do NOT use any citation id not present in SOURCES. Do NOT write a Sources section — it is appended automatically.\n\nQUESTION: the question\n\nVERIFIED CLAIMS — (id) text:\n(1) Fact A\n\nSOURCES:\n[1] Site A — https://a.example/x",
          "options": {
            "agentType": null,
            "model": null,
            "isolation": null,
            "outputSchema": null
          }
        }
