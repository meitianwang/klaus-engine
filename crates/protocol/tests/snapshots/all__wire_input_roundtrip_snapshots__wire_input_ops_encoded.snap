---
source: crates/protocol/tests/wire_input_roundtrip_snapshots.rs
expression: "format!(\"{}\\n{}\\n{}\\n{}\", roundtrip(&text), roundtrip(&parts),\nroundtrip(&empty_parts), roundtrip(&steer))"
---
{
  "id": "run-text",
  "op": {
    "type": "run",
    "input": "héllo 世界"
  }
}
{
  "id": "run-parts",
  "op": {
    "type": "run",
    "input": [
      {
        "type": "text",
        "text": "look at this"
      },
      {
        "type": "image",
        "base64": "aGk=",
        "mimeType": "image/png"
      },
      {
        "type": "document",
        "base64": "ZG9j",
        "mimeType": "application/pdf"
      },
      {
        "type": "document",
        "base64": "ZG9j",
        "mimeType": "application/pdf",
        "filename": "规格 v2.pdf"
      }
    ]
  }
}
{
  "id": "run-empty",
  "op": {
    "type": "run",
    "input": []
  }
}
{
  "id": "steer-1",
  "op": {
    "type": "steer",
    "input": "change course"
  }
}
